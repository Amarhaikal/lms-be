# .env.example
# Copy this to .env and fill in your values
# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=quantm_db
MYSQL_USER=quantm_user
MYSQL_PASSWORD=change_me
# Backend Configuration
DB_HOST=mysql
DB_NAME=quantm_db
DB_USER=quantm_user
DB_PASSWORD=change_me

# JWT Settings
JWT_KEY=change_me_min_32_chars
JWT_ISSUER=QUANTMAPI
JWT_AUDIENCE=QUANTMAPIUsers

# Email Settings
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_NAME="Quantm Bank"
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_USERNAME=username
EMAIL_PASSWORD=password

# Encryption Keys
ENCRYPTION_KEY=
ENCRYPTION_SALT=